+/** localStorage auth keys are only refresh tokens and there is no app-origin cookie. */
+export function refreshTokenOnly(readiness: SeedReadiness): boolean {
+  const names = readiness.localStorageAuthKeyNames
+  return (
+    readiness.shape === "local-storage-auth" &&
+    !readiness.appOriginCookies &&
+    names.length > 0 &&
+    names.every((name) => /^refresh_?token$/i.test(name))
+  )
+}
